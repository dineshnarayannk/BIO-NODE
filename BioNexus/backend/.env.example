# BioNexus Backend Environment Variables Template

# Application
APP_NAME="BioNexus API"
APP_ENV="development"
DEBUG=True
API_HOST="0.0.0.0"
API_PORT=8000

# CORS Configuration (Comma-separated list of allowed frontend origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ==================================================
# TiDB Cloud / MySQL Database Configuration
# ==================================================
# You can provide a full DATABASE_URL or configure individual parameters below:
# Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?ssl_verify_cert=true

DATABASE_URL=""

# Individual connection parameters (alternative to DATABASE_URL)
DB_HOST=""
DB_PORT=4000
DB_USER=""
DB_PASSWORD=""
DB_NAME="bionexus"

# SSL/TLS Configuration for TiDB Cloud
# Path to system CA root bundle (e.g. /etc/ssl/cert.pem on macOS or /etc/ssl/certs/ca-certificates.crt on Linux)
DB_SSL_CA=""
DB_SSL_VERIFY_CERT=True

# Connection Pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==================================================
# AI & LLM Integrations (Future Phases)
# ==================================================
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Data directory
DATA_DIR="../../data"
